# =============================================================================
# AI Interview Preparation Application - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Settings (Vite)
# -----------------------------------------------------------------------------
# Your Supabase Project URL and Anon/Public Key (for database and auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL of the local backend server (leave empty to use Vite reverse-proxy)
VITE_BACKEND_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Backend Server Settings
# -----------------------------------------------------------------------------
PORT=5000

# AI Provider Selection:
# - 'auto'        : Automatically detects local Ollama, falls back to Groq, then heuristic offline engine
# - 'ollama'      : Always prioritize local Ollama instance
# - 'groq'        : Use free Groq API cloud key
# - 'huggingface' : Use free HuggingFace API key
# - 'mock'        : Run pure local offline heuristic generator (no external dependencies)
AI_PROVIDER=auto

# -----------------------------------------------------------------------------
# Option A: Local Ollama Settings (Zero-Token / 100% Free & Unlimited)
# -----------------------------------------------------------------------------
# Download and install Ollama from https://ollama.com
# Recommended models:
#   - llama3.2:1b (fast, lightweight ~1.3 GB)
#   - llama3.2    (standard 3B model)
#   - mistral     (7B model)
#   - phi3        (compact Microsoft model)
# Run: ollama run llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Option B: Free Cloud AI Keys (Optional Fallbacks)
# -----------------------------------------------------------------------------
# Groq provides high-speed free tier at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# HuggingFace Serverless Inference API (Free tier at https://huggingface.co)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# -----------------------------------------------------------------------------
# Offline Fallback Engine
# -----------------------------------------------------------------------------
# If true, the system guarantees 0% downtime by returning intelligent,
# schema-compliant interview questions, feedback, and ATS scores even if
# all AI providers are temporarily offline.
ENABLE_MOCK_FALLBACK=true
